# Copy to .env and fill in. No real secrets belong in this file.
#
# docker-compose passes this whole file to the backend container (`env_file`),
# so any setting added here reaches the app without editing docker-compose.yml.
# The one exception is DATABASE_URL -- see the note on it below.
# The file is optional: with no .env at all, everything falls back to the
# defaults in backend/app/settings.py, and only real LLM calls will fail.

# ---- LLM access ----------------------------------------------------------
# Required for real runs. Tests stub the LLM and do not need it.
ANTHROPIC_API_KEY=sk-ant-replace-me

# Platform-level models. Worker agent models live in backend/config/agents.yaml.
PLANNER_MODEL=claude-opus-5
SYNTHESIZER_MODEL=claude-opus-5

# ---- Postgres ------------------------------------------------------------
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator
POSTGRES_DB=orchestrator
# Host port the compose Postgres is published on. Defaults to 5433 so it does
# not collide with a Postgres you may already run on 5432.
POSTGRES_HOST_PORT=5433

# The only setting docker-compose deliberately OVERRIDES rather than takes from
# this file: inside the compose network the database is `postgres:5432`, and a
# localhost URL would point the backend container at itself. The value below is
# for running uvicorn on your host against `docker compose up postgres`.
DATABASE_URL=postgresql+psycopg://orchestrator:orchestrator@localhost:5433/orchestrator

# ---- MCP tool policy -----------------------------------------------------
MCP_TOOL_TIMEOUT_SECONDS=30
MCP_TOOL_MAX_ATTEMPTS=3

# ---- Planner retrieval ---------------------------------------------------
PLANNER_AGENT_TOP_K=5
PLANNER_TOOL_TOP_K=12
PLANNER_MEMORY_TOP_K=3

# ---- Frontend ------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
